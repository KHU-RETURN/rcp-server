[Unit]
Description=RCP ssh-gateway (SSH bastion bridging users to tenant VMs via ns-proxy)
After=network-online.target ns-proxy.service
Wants=network-online.target
Requires=ns-proxy.service

[Service]
Type=simple
User=return
Group=return

EnvironmentFile=/etc/rcp/ssh-gateway.env

ExecStart=/usr/local/bin/ssh-gateway

# /run/rcp/ 자동 생성 + 권한 (재부팅 후에도 유지)
RuntimeDirectory=rcp
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# host key 영구 저장 디렉토리 (사용자 known_hosts 안전을 위해 재부팅·재배포 시 보존되어야 함)
# 사전에 mkdir -p /etc/rcp/ssh-gateway && chown return:return /etc/rcp/ssh-gateway && chmod 0700
# 첫 실행 시 host_ed25519이 없으면 자동 생성한다.

# 보안 강화
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# 공유 SQLite DB는 API(rcp-server) 홈에 있고 gateway는 읽기 전용으로만 연다.
# ProtectHome=true 를 유지한 채 그 DB 파일 하나만 네임스페이스에 read-only로 노출한다.
# (API가 schema/write ownership을 가지며, 파일이 아직 없으면 '-' 접두사로 부팅을 막지 않는다.
#  DB 생성 후 gateway 재시작 필요.)
BindReadOnlyPaths=-/home/return/rcp-server/rcp.db
ReadWritePaths=/run/rcp /etc/rcp/ssh-gateway

# Linux capability — 1024 미만 포트(예: 22)에 listen할 경우에만 필요.
# 기본 2222 포트면 제거 가능.
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Restart=on-failure
RestartSec=2s

# graceful shutdown
TimeoutStopSec=35s
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
