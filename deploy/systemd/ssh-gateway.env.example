# RCP ssh-gateway 환경 설정
# /etc/rcp/ssh-gateway.env 로 복사 후 환경에 맞게 수정.
# 권한: chown root:return /etc/rcp/ssh-gateway.env && chmod 0640 /etc/rcp/ssh-gateway.env

# outer SSH 서버 listen 주소. 기본값(`127.0.0.1:2222`)은 외부에 직접 노출되지
# 않으며 cloudflared 같은 호스트-로컬 터널이 라우팅한다 (deploy/cloudflared 참고).
# 직접 노출하려면 :2222 (모든 인터페이스), 22번을 쓰려면 systemd 유닛에
# CAP_NET_BIND_SERVICE 활성화 필요.
RCP_SSH_GW_LISTEN=127.0.0.1:2222

# OpenStack 인증. gateway가 VM fixed IP를 조회할 때 사용.
OS_AUTH_URL=https://openstack.example.com:5000/v3
OS_USERNAME=return
OS_PASSWORD=REPLACE-WITH-PASSWORD
OS_PROJECT_NAME=return
OS_USER_DOMAIN_NAME=Default
CF_ACCESS_CLIENT_ID=REPLACE-WITH-CF-ACCESS-CLIENT-ID
CF_ACCESS_CLIENT_SECRET=REPLACE-WITH-CF-ACCESS-CLIENT-SECRET

# outer host key 경로. 없으면 첫 실행에 자동 생성.
# 사용자 known_hosts 안전을 위해 재부팅·재배포 시 보존되어야 함.
RCP_SSH_GW_HOST_KEY_PATH=/etc/rcp/ssh-gateway/host_ed25519

# inner VM host key 신뢰 저장소. 없거나 VM 키가 없으면 fail closed.
# VM 생성/운영 단계에서 `ssh-keyscan <fixed-ip> >> /etc/rcp/ssh-gateway/known_hosts`.
RCP_SSH_GW_KNOWN_HOSTS_PATH=/etc/rcp/ssh-gateway/known_hosts

# RCP API → gateway notify Unix socket. 같은 그룹(return)이 connect할 수 있어야 함 (0o660).
RCP_SSH_GW_NOTIFY_SOCK=/run/rcp/ssh-gateway-notify.sock

# notify 위조 방지용 HMAC-SHA256 공유 비밀.
# 동일 값을 RCP API의 RCP_SSH_GW_NOTIFY_SECRET 에도 설정.
# 32바이트 이상 권장. 생성: openssl rand -hex 32
RCP_SSH_GW_NOTIFY_SECRET=REPLACE-WITH-HEX-SECRET

# ns-proxy Unix socket. tenant 네트워크로 가는 유일한 경로.
RCP_NS_PROXY_SOCK=/run/rcp/ns-proxy.sock

# keyboard-interactive에 출력할 OAuth URL의 base.
# 예: https://rcp.return.dev → 사용자에게 URL과 터미널 입력용 6자리 코드 표시.
RCP_SSH_GW_AUTH_URL_BASE=https://rcp.return.dev

# nonce 수명. 만료 시 keyboard-interactive 종료 + "auth timeout".
RCP_SSH_GW_NONCE_TTL=5m

# pending OAuth 세션 전역 상한. 초과 시 새 SSH auth 시도는 거부된다.
RCP_SSH_GW_MAX_PENDING_SESSIONS=1024

# 여러 tenant network fixed IP가 붙은 VM에서는 반드시 대상 network를 지정한다.
# 비워 두면 fixed IPv4가 정확히 1개일 때만 접속한다.
RCP_SSH_GW_FIXED_NETWORK=

# inner VM SSH 로그인 사용자. Ubuntu cloud image 등 root 로그인이 막힌 이미지에서는 ubuntu 등으로 변경.
RCP_SSH_GW_VM_USER=root

# ent SQLite 파일 경로. 게이트웨이는 user → instances 조회만 수행하고 migration은 실행하지 않음.
# fallback DSN은 mode=ro로 열리므로 API가 schema와 write ownership을 유지한다.
RCP_SSH_GW_DB_PATH=/var/lib/rcp/rcp.db

# 수동 설치 전용 고급 override: gateway 전용 Postgres 등 DSN을 직접 지정할 때만 사용.
# 배포 워크플로는 공유 DB_DSN을 gateway에 전달하지 않고 RCP_SSH_GW_DB_PATH를 사용한다.
# DB_DSN이 있으면 RCP_SSH_GW_DB_PATH는 무시됨.
# DB_DRIVER=postgres
# DB_DSN=host=localhost port=5432 user=rcp password=secret dbname=rcp sslmode=disable

# 로그 레벨: debug | info | warn | error
RCP_SSH_GW_LOG_LEVEL=info
