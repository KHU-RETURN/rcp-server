# RCP ssh-gateway 환경 설정
# /etc/rcp/ssh-gateway.env 로 복사 후 환경에 맞게 수정.
# 권한: chown root:rcp /etc/rcp/ssh-gateway.env && chmod 0640 /etc/rcp/ssh-gateway.env

# outer SSH 서버 listen 주소. 기본값(`127.0.0.1:2222`)은 외부에 직접 노출되지
# 않으며 cloudflared 같은 호스트-로컬 터널이 라우팅한다 (deploy/cloudflared 참고).
# 직접 노출하려면 :2222 (모든 인터페이스), 22번을 쓰려면 systemd 유닛에
# CAP_NET_BIND_SERVICE 활성화 필요.
RCP_SSH_GW_LISTEN=127.0.0.1:2222

# outer host key 경로. 없으면 첫 실행에 자동 생성.
# 사용자 known_hosts 안전을 위해 재부팅·재배포 시 보존되어야 함.
RCP_SSH_GW_HOST_KEY_PATH=/etc/rcp/ssh-gateway/host_ed25519

# RCP API → gateway notify Unix socket. 같은 그룹(rcp)이 connect할 수 있어야 함 (0o660).
RCP_SSH_GW_NOTIFY_SOCK=/run/rcp/ssh-gateway-notify.sock

# notify 위조 방지용 HMAC-SHA256 공유 비밀.
# 동일 값을 RCP API의 RCP_SSH_GW_NOTIFY_SECRET 에도 설정.
# 32바이트 이상 권장. 생성: openssl rand -hex 32
RCP_SSH_GW_NOTIFY_SECRET=REPLACE-WITH-HEX-SECRET

# ns-proxy Unix socket. tenant 네트워크로 가는 유일한 경로.
RCP_NS_PROXY_SOCK=/run/rcp/ns-proxy.sock

# keyboard-interactive에 출력할 OAuth URL의 base.
# 예: https://rcp.return.dev → 사용자에게 https://rcp.return.dev/ssh-auth?s=<nonce> 표시.
RCP_SSH_GW_AUTH_URL_BASE=https://rcp.return.dev

# nonce 수명. 만료 시 keyboard-interactive 종료 + "auth timeout".
RCP_SSH_GW_NONCE_TTL=5m

# ent SQLite 파일 경로. 게이트웨이는 user → instances 조회만 수행 (read).
DB_DRIVER=sqlite3
DB_DSN=file:rcp.db?cache=shared&_pragma=foreign_keys(1)

# 로그 레벨: debug | info | warn | error
RCP_SSH_GW_LOG_LEVEL=info
