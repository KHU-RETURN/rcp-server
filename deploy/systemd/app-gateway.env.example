# RCP app-gateway 환경 설정
# /etc/rcp/app-gateway.env 로 복사 후 환경에 맞게 수정.
# 권한: chown root:return /etc/rcp/app-gateway.env && chmod 0640 /etc/rcp/app-gateway.env

# Nginx가 Host 기반으로 전달할 내부 HTTP 포트.
APP_GATEWAY_PORT=18080

# API 서버와 같은 DB를 바라봐야 host -> instance 매핑을 조회할 수 있습니다.
DB_DRIVER=postgres
DB_DSN=host=localhost port=5432 user=rcp password=secret dbname=rcp sslmode=disable

# ns-proxy Unix socket 경로.
RCP_NS_PROXY_SOCK=/run/rcp/ns-proxy.sock

# Nova fixed IP 조회 결과 캐시 TTL. 만료 후 조회 실패 시 마지막 성공 IP를 fallback으로 사용합니다.
RCP_APP_GW_FIXED_IP_CACHE_TTL=5m

# fixed IP 조회용 OpenStack 인증 설정.
OS_AUTH_URL=https://openstack.example.com:5000/v3
OS_USERNAME=return
OS_PASSWORD=secret
OS_PROJECT_NAME=return
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_ID=replace-with-project-id

# OpenStack API 앞에 Cloudflare Access가 있는 경우.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
